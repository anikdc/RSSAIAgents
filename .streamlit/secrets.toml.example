# Copy this to secrets.toml for local testing with st.secrets,
# or paste the contents into Streamlit Community Cloud's Secrets panel.
#
# When deployed, Streamlit reads these as st.secrets["KEY"].
# The load_secrets() shim in src/secrets_helper.py writes them into
# os.environ so that existing os.getenv() calls work unchanged.

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.1-flash-lite-preview"
GEMINI_EMBEDDING_MODEL = "gemini-embedding-001"
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "qwen-2.5-32b"
