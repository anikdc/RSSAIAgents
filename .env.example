# LLM provider. Supported values: gemini, groq.
LLM_PROVIDER=gemini

# Gemini configuration.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local SentenceTransformer cache behavior.
# Set to true after the SentenceTransformer model has been downloaded once.
SENTENCE_TRANSFORMERS_LOCAL_ONLY=false
# Set to 1 to prevent Hugging Face network checks once the model is cached.
HF_HUB_OFFLINE=0

# Optional Groq configuration. Install with: uv sync --extra groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Python worker API.
PYTHON_WORKER_PORT=8000
PYTHON_WORKER_MAX_JOBS=2

# MERN API and web app.
EXPRESS_PORT=4000
PYTHON_WORKER_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:4000

# MongoDB persistence. Leave empty to use the local JSON fallback.
MONGODB_URI=
MONGODB_DB=rssaiagents
